{
	"name": "cue-script",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"data": "tsx scripts/build-data.ts",
		"predev": "node scripts/ensure-data.mjs",
		"prebuild": "node scripts/ensure-data.mjs",
		"pretest": "node scripts/ensure-data.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@fontsource/eb-garamond": "^5.3.0",
		"@fontsource/im-fell-english": "^5.3.0",
		"@fontsource/im-fell-english-sc": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"@xmldom/xmldom": "^0.9.12",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Cue scripts for every part in Shakespeare, generated from the Folger Shakespeare texts, with rehearsal tools.",
	"dependencies": {
		"fflate": "^0.8.3",
		"pdfjs-dist": "^6.5.438"
	}
}
